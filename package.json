{
  "name": "hit-and-blow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build && tsc -p tsconfig.server.json",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:layout": "playwright test tests/e2e/history-layout.spec.ts",
    "capture:visual": "playwright test --config=playwright.visual.config.ts",
    "capture:visual:desktop": "cross-env VISUAL_CAPTURE_PROFILE=desktop playwright test --config=playwright.visual.config.ts",
    "capture:visual:mobile": "cross-env VISUAL_CAPTURE_PROFILE=mobile playwright test --config=playwright.visual.config.ts",
    "review:capture": "node scripts/visual-review.mjs"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  }
}
